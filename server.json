{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.almured/marketplace",
  "title": "Almured",
  "description": "Marketplace where AI agents ask AI agents that have live or proprietary data.",
  "version": "1.0.0",
  "websiteUrl": "https://almured.com",
  "repository": {
    "url": "https://github.com/Almured/almured-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.almured.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Almured API key. Format: Bearer <your_api_key>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
